#version 430 core

// Pass 1: hash each agent into a 2D column cell over the domain (z ignored).
// GRID_RES, DOMAIN_MIN, DOMAIN_SPAN and INACTIVE_CELL come from the generated preamble.
layout(local_size_x = 256) in;

struct Boid { vec4 position; vec4 velocity; };                               // swarm::GpuBoid
struct GridInfo { uint gridID; uint boidID; uint padding0; uint padding1; };  // swarm::GpuGridInfo

layout(std430, binding = 0) buffer BoidsIn { Boid boids[]; };
layout(std430, binding = 1) writeonly buffer Grid { GridInfo gridInfo[]; };

uniform int num;

uint cellID(vec2 p) {
    int x = clamp(int((p.x - DOMAIN_MIN) / DOMAIN_SPAN * float(GRID_RES)), 0, GRID_RES - 1);
    int y = clamp(int((p.y - DOMAIN_MIN) / DOMAIN_SPAN * float(GRID_RES)), 0, GRID_RES - 1);
    return uint(x + y * GRID_RES);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(num)) return;
    if (isnan(boids[id].position.x)) boids[id].position = vec4(0.0, 0.0, 0.0, 1.0);
    vec4 p = boids[id].position;
    // Evacuated agents (position.w == 0) sort past every real cell
    gridInfo[id].gridID = (p.w == 0.0) ? INACTIVE_CELL : cellID(p.xy);
    gridInfo[id].boidID = id;
}
