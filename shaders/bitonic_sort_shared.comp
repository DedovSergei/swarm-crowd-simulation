#version 430 core

// Pass 2, shared-memory stages: the passes of bitonic_sort.comp's network whose
// partner distance j is below 512, run in shared memory on 512-element tiles (two elements per
// invocation). The network is unchanged: every compare-exchange pairs element p with p ^ j, sorts
// ascending where (p & k) == 0, compares gridID only with the same strict test and swaps whole
// 16-byte entries. Every pair with j < 512 lies inside one tile and the network does not depend on
// the data, so the result is byte-identical to running these passes one global dispatch each.
//   mode 0: all passes of the stages k = 2 .. min(num, 512): each tile sorted, alternating direction
//   mode 1: the passes j = 256 .. 1 of one stage k >= 1024 (its j >= 512 passes ran before, one
//           global dispatch each, in bitonic_sort.comp)
layout(local_size_x = 256) in;

struct GridInfo { uint gridID; uint boidID; uint padding0; uint padding1; };  // swarm::GpuGridInfo

layout(std430, binding = 1) buffer Grid { GridInfo gridInfo[]; };

uniform int num;    // agent count, a power of two >= 256 (at 256 the one tile is half full)
uniform int mode;
uniform int k;      // mode 1: the stage

shared GridInfo tile[512];

// Pass (kk, jj) of the tile at 'base': invocation t takes the t-th pair (lo, lo + jj) of the tile,
// lo = t with a 0 inserted at bit log2(jj), with the direction bitonic_sort.comp gives element base + lo
void compareExchange(uint base, uint t, uint kk, uint jj) {
    uint lo = ((t & ~(jj - 1u)) << 1u) | (t & (jj - 1u));
    uint hi = lo | jj;
    if (base + hi >= uint(num)) return;   // num = 256 only: the pair lies in the empty upper half
    bool asc = ((base + lo) & kk) == 0u;
    uint gl = tile[lo].gridID;
    uint gh = tile[hi].gridID;
    if ((asc && gl > gh) || (!asc && gl < gh)) {
        GridInfo x = tile[lo];
        tile[lo] = tile[hi];
        tile[hi] = x;
    }
}

void main() {
    uint t = gl_LocalInvocationID.x;
    uint base = gl_WorkGroupID.x * 512u;
    uint n = uint(num);
    if (base + t < n) tile[t] = gridInfo[base + t];
    if (base + t + 256u < n) tile[t + 256u] = gridInfo[base + t + 256u];
    memoryBarrierShared();
    barrier();
    if (mode == 0) {
        uint kEnd = min(n, 512u);
        for (uint kk = 2u; kk <= kEnd; kk <<= 1u) {
            for (uint jj = kk >> 1u; jj > 0u; jj >>= 1u) {
                compareExchange(base, t, kk, jj);
                memoryBarrierShared();
                barrier();
            }
        }
    } else {
        for (uint jj = 256u; jj > 0u; jj >>= 1u) {
            compareExchange(base, t, uint(k), jj);
            memoryBarrierShared();
            barrier();
        }
    }
    if (base + t < n) gridInfo[base + t] = tile[t];
    if (base + t + 256u < n) gridInfo[base + t + 256u] = tile[t + 256u];
}
