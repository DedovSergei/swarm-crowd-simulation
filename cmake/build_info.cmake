# Build-time commit metadata. Runs in script mode on EVERY build (custom target
# swarm_build_info_gen in CMakeLists.txt):
#
#   cmake -DSRC_DIR=<source tree> -DOUT=<header> [-DGIT=<git executable>] -P build_info.cmake
#
# Asks git for HEAD and the working-tree state of SRC_DIR and rewrites OUT only when a value
# changed, so an unchanged state rebuilds nothing (the custom target lists OUT as a byproduct, which
# makes Ninja re-check its timestamp). Nothing here depends on the configure step or on the reflog:
# a commit followed by a plain rebuild reports the new commit, also in a fresh worktree.
#
# Values: SWARM_GIT_COMMIT = the full SHA-1 of HEAD; SWARM_GIT_DIRTY = 1 when 'git status
# --porcelain' lists anything (modified, staged, deleted or untracked files that .gitignore does
# not exclude: the build globs shaders/*, so an untracked file can be part of the build), 0 when it
# lists nothing. Both are "unknown" / -1 without git, or when SRC_DIR is not the top level of its
# own git checkout (a 'git archive' export inside another repository must not report that
# repository's HEAD).

if(NOT SRC_DIR OR NOT OUT)
    message(FATAL_ERROR "build_info.cmake: SRC_DIR and OUT are required")
endif()

set(commit "unknown")
set(dirty -1)
if(GIT)
    execute_process(COMMAND "${GIT}" -C "${SRC_DIR}" rev-parse --show-toplevel
                    RESULT_VARIABLE rc OUTPUT_VARIABLE top OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    set(own_checkout FALSE)
    if(rc EQUAL 0 AND top)
        file(REAL_PATH "${top}" top_real)
        file(REAL_PATH "${SRC_DIR}" src_real)
        if(CMAKE_HOST_WIN32)   # case-insensitive file system
            string(TOLOWER "${top_real}" top_real)
            string(TOLOWER "${src_real}" src_real)
        endif()
        if(top_real STREQUAL src_real)
            set(own_checkout TRUE)
        endif()
    endif()
    if(own_checkout)
        execute_process(COMMAND "${GIT}" -C "${SRC_DIR}" rev-parse --verify HEAD
                        RESULT_VARIABLE rc OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(rc EQUAL 0 AND head MATCHES "^[0-9a-f]+$")
            set(commit "${head}")
            # --no-optional-locks: never take index.lock (a concurrent git command in the tree must not fail)
            execute_process(COMMAND "${GIT}" --no-optional-locks -C "${SRC_DIR}" status --porcelain
                            RESULT_VARIABLE rc OUTPUT_VARIABLE status ERROR_QUIET)
            if(rc EQUAL 0)
                string(STRIP "${status}" status)
                if(status STREQUAL "")
                    set(dirty 0)
                else()
                    set(dirty 1)
                endif()
            endif()
        endif()
    endif()
endif()

if(commit STREQUAL "unknown")
    set(short "unknown")
    set(describe "unknown")
else()
    string(SUBSTRING "${commit}" 0 7 short)
    set(describe "${short}")
    if(dirty EQUAL 1)
        set(describe "${short}-dirty")
    endif()
endif()

set(content "// Generated by cmake/build_info.cmake on every build; rewritten only when a value changes.
// Included only by src/build_info.cpp (declarations: include/swarm/build_info.hpp).
#pragma once
#define SWARM_GIT_COMMIT \"${commit}\"
#define SWARM_GIT_COMMIT_SHORT \"${short}\"
#define SWARM_GIT_DIRTY ${dirty}
#define SWARM_GIT_DESCRIBE \"${describe}\"
")

set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
    message(STATUS "build info: ${describe} (${commit}, dirty ${dirty}) -> ${OUT}")
endif()
